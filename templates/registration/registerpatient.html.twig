{% extends 'base.html.twig' %}
{% block stylesheets %}
            {{ encore_entry_link_tags('app') }}
 <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-1BmE4kWBq78iYhFldvKuhfTAU6auU8tT94WrHftjDbrCEXSU1oBoqyl2QvZ6jIW3" crossorigin="anonymous">           
{% endblock %}

{% block javascripts %}
            {{ encore_entry_script_tags('app') }}
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-ka7Sk0Gln4gmtz2MlQnikT1wXgYsOg+OMhuP+IlRH9sENBO0LRn5q+8nbTov4+1p" crossorigin="anonymous"></script>           
{% endblock %}
 

{% block title %}Register{% endblock %}

{% block body %}
     <div class="row mx-lg-4">
        <div class="col-md-12">
            <h1 class="text-center text-uppercase">Inscription</h1><br>
            {{ form_start(registrationForm) }}
            <div class="container-connexion">
                <div class="card-connexion">
                    <div class="card-connexion2">
                            <label for="inputEmail">Email</label>
                            {{ form_widget(registrationForm.email, {'attr': {'placeholder': '','class' : 'form-control col-mx-4 mb-3'}}) }}
                            <span class="error">{{ form_errors(registrationForm.email) }}</span>

                            <label for="inputEmail">Nom</label>
                            {{ form_widget(registrationForm.nom, {'attr': {'placeholder': '','class' : 'form-control col-mx-4 mb-3'}}) }}
                            <span class="error">{{ form_errors(registrationForm.nom) }}</span>

                            <label for="inputPrenom">Prenom</label>
                            {{ form_widget(registrationForm.prenom, {'attr': {'placeholder': '','class' : 'form-control col-mx-4 mb-3'}}) }}
                            <span class="error">{{ form_errors(registrationForm.prenom) }}</span>

                            <label for="inputPrenom">Sexe</label>
                            {{ form_widget(registrationForm.sexe, {'attr': {'placeholder': '','class' : 'form-control col-mx-4 mb-3'}}) }}
                            <span class="error">{{ form_errors(registrationForm.sexe) }}</span>

                            <label for="inputnumtel">Numero de telephone</label>
                            {{ form_widget(registrationForm.numero_telephone, {'attr': {'placeholder': '','class' : 'form-control col-mx-4 mb-3'}}) }}
                            <span class="error">{{ form_errors(registrationForm.numero_telephone) }}</span>
                            
                             <label for="inputPassword">Mot de passe</label>
                            {{ form_widget(registrationForm.plainPassword, {'attr': {'placeholder': '','class' : 'form-control col-mx-4 mb-3'}}) }}
                            <span class="error">{{ form_errors(registrationForm.plainPassword) }}</span>
                            
                            {{ form_row(registrationForm.agreeTerms) }}

                        <div class="col text-center">
                            <input type="submit" name="" class="btn btn-primary" value="S'inscrire">
                        </div><br>
                    </div>
                </div>
            </div>
            {{ form_end(registrationForm) }}
        </div>
    </div>
{% endblock %}