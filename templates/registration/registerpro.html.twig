{% extends 'base.html.twig' %}
{% block stylesheets %}
            {{ encore_entry_link_tags('app') }}
 <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.0.0/css/bootstrap.min.css" integrity="sha384-Gn5384xqQ1aoWXA+058RXPxPg6fy4IWvTNh0E263XmFcJlSAwiGgFAW/dAiS6JXm" crossorigin="anonymous">           
{% endblock %}

{% block title %}Register{% endblock %}

{% block body %}
    <div class="row mx-lg-4">
        <div class="col-md-12">
            <h2 class="text-center text-uppercase">Inscription Professionnelle</h2><br>
            {{ form_start(registrationProForm) }}
            <div class="container-connexion">
                <div class="card-connexion">
                    <div class="card-connexion2">
                            <label for="inputEmail">Email</label>
                            {{ form_widget(registrationProForm.email, {'attr': {'placeholder': '','class' : 'form-control col-mx-4 mb-3'}}) }}
                            <span class="error">{{ form_errors(registrationProForm.email) }}</span>

                            <label for="inputEmail">Nom</label>
                            {{ form_widget(registrationProForm.nom, {'attr': {'placeholder': '','class' : 'form-control col-mx-4 mb-3'}}) }}
                            <span class="error">{{ form_errors(registrationProForm.nom) }}</span>

                            <label for="inputPrenom">Prenom</label>
                            {{ form_widget(registrationProForm.prenom, {'attr': {'placeholder': '','class' : 'form-control col-mx-4 mb-3'}}) }}
                            <span class="error">{{ form_errors(registrationProForm.prenom) }}</span>

                            <label for="inputPrenom">Sexe</label>
                            {{ form_widget(registrationProForm.sexe, {'attr': {'placeholder': '','class' : 'form-control col-mx-4 mb-3'}}) }}
                            <span class="error">{{ form_errors(registrationProForm.sexe) }}</span>

                            <label for="inputnumtel">Numero de telephone</label>
                            {{ form_widget(registrationProForm.numeroTelephone, {'attr': {'placeholder': '','class' : 'form-control col-mx-4 mb-3'}}) }}
                            <span class="error">{{ form_errors(registrationProForm.numeroTelephone) }}</span>

                            <label for="inputnumtel">Votre date de naissance</label>
                            {{ form_widget(registrationProForm.dateNaissance, {'attr': {'placeholder': '','class' : 'form-control col-mx-4 mb-3'}}) }}
                            <span class="error">{{ form_errors(registrationProForm.dateNaissance) }}</span>
                            
                             <label for="inputPassword">Mot de passe</label>
                            {{ form_widget(registrationProForm.plainPassword, {'attr': {'placeholder': '','class' : 'form-control col-mx-4 mb-3'}}) }}
                            <span class="error">{{ form_errors(registrationProForm.plainPassword) }}</span>

                            <label for="inputnumtel">Votre type de Profession</label>
                            {{ form_widget(registrationProForm.typeProfession, {'attr': {'placeholder': '','class' : 'form-control col-mx-4 mb-3'}}) }}
                            <span class="error">{{ form_errors(registrationProForm.typeProfession) }}</span>

                            <label for="inputnumtel">Faites une petite présentation</label>
                            {{ form_widget(registrationProForm.presentation, {'attr': {'placeholder': '','class' : 'form-control col-mx-4 mb-3'}}) }}
                            <span class="error">{{ form_errors(registrationProForm.presentation) }}</span>

                            <label for="inputnumtel">Langues Parlées</label>
                            {{ form_widget(registrationProForm.languesParlees, {'attr': {'placeholder': '','class' : 'form-control col-mx-4 mb-3'}}) }}
                            <span class="error">{{ form_errors(registrationProForm.languesParlees) }}</span>

                            <label for="inputnumtel">Choisir l'établissement auquel vous êtes affecté</label>
                            {{ form_widget(registrationProForm.lEtablissement, {'attr': {'placeholder': '','class' : 'form-control col-mx-4 mb-3'}}) }}
                            <span class="error">{{ form_errors(registrationProForm.lEtablissement) }}</span>

                            {{ form_row(registrationProForm.agreeTerms) }}

                        <div class="col text-center">
                            <input type="submit" name="" class="btn btn-primary" value="S'inscrire">
                        </div><br>
                    </div>
                </div>
            </div>
            {{ form_end(registrationProForm) }}
        </div>
    </div>
{% endblock %}