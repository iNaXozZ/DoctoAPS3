{% extends 'base.html.twig' %}

{% block title %}Accueil{% endblock %}

{% block stylesheets %}
            {{ encore_entry_link_tags('app') }}
            
        {% endblock %}

        
        {% block javascripts %}
            {{ encore_entry_script_tags('app') }}
            
        {% endblock %}
{% block body %}
<h2><center>Bienvenue sur l'acceuil DoctoAPS3<center></h2>
<br>
<div class="card">
