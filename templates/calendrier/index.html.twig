{% extends 'security/authentificationReussie.html.twig' %}

{% block title %}Calendrier{% endblock %}

{% block body %}
<h2><center>Voici votre Planning Mr/Mrs {{ app.user.nom }} {{ app.user.prenom }}<center></h2>
<div class="col-12">
          <table class="table">
            <thead>
              <tr>
              {% for lejour in lesjours %}
                <th class="text-dark text-left">{{ lejour|format_datetime('full', 'none', locale='fr')  }} </th> 
              {% endfor %}  
              </tr>
            </thead>
            <tbody>
               {% for lheure in lesheures %}
              <tr>
              {% for lejour in lesjours %} 
                <td><a href="/gestionConsultation/{{ lejour|date("d/m/Y") }}/{{ lheure|format_datetime('none', 'short', locale='fr') }}">{{ lheure|format_datetime('none', 'short', locale='fr')  }} H</a></td>   
             {% endfor %} 
              </tr>
             {% endfor %}  
            </tbody>
          </table>
        </div>
{% endblock %}

